/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans          &kp Q  &kp W  &kp E      &kp R   &kp T        &kp Y      &kp U       &kp I      &kp O       &kp P          &to 2
&trans          &kp A  &kp S  &kp D      &kp F   &kp G        &kp H      &kp J       &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V   &kp B        &kp N      &kp M       &kp COMMA  &kp PERIOD  &kp SLASH      &kp RG(SPACE)
                              &kp RG(Q)  &trans  &kp ENTER    &kp SPACE  &kp DELETE  &to 1
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &mmv MOVE_UP    &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans          &trans          &trans           &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mmv MOVE_DOWN  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

